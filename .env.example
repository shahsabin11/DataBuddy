# -----------------------------------------------------------------------------
# DataBuddy local / pilot environment
# Copy to .env and fill in values. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- App ---
# public site origin used in OAuth redirects and CORS
APP_URL=http://localhost:3000
# FastAPI origin (browser reaches this via Next.js rewrite at /api)
API_URL=http://localhost:8000
# comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# random 32+ byte string used to sign the session cookie
SESSION_SECRET=replace-with-a-long-random-string
# cookie name for the DataBuddy session (httpOnly, same-site)
SESSION_COOKIE_NAME=databuddy_session
# environment label: local | staging | production
ENVIRONMENT=local
# log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Postgres ---
# Compose service hostname is "postgres". Locally use localhost.
# Owner/migrator (Alembic, seed). Not used for student HTTP requests.
DATABASE_URL=postgresql+psycopg://databuddy:databuddy@localhost:5432/databuddy
# FastAPI request role — RLS forced, no BYPASSRLS (created by migration 0003).
DATABASE_APP_URL=postgresql+psycopg://databuddy_app:databuddy_app@localhost:5432/databuddy
# Platform-admin role only — BYPASSRLS. Never for student traffic.
DATABASE_ADMIN_URL=postgresql+psycopg://databuddy_admin:databuddy_admin@localhost:5432/databuddy
# used by docker-compose to create the database
POSTGRES_USER=databuddy
POSTGRES_PASSWORD=databuddy
POSTGRES_DB=databuddy

# --- Object storage (MinIO locally; Cloudflare R2 or S3 in production) ---
# local = disk under LOCAL_STORAGE_PATH (no MinIO/Docker). s3 = MinIO/R2/S3.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.data/objects
# S3-compatible endpoint. Leave empty for real AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=databuddy
# public browser-facing MinIO URL (host machine, not the Docker hostname)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# force path-style URLs (required for MinIO)
S3_FORCE_PATH_STYLE=true
# Short-lived signed GET URL lifetime (seconds)
S3_PRESIGN_TTL_SECONDS=300
# Upload hard cap (bytes); 500 MiB default
MAX_UPLOAD_BYTES=524288000

# --- OAuth (Google) ---
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback through Next.js so the session cookie is set on the app origin.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- OAuth (Microsoft) ---
# Create in Azure Entra ID app registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Email (student project invites) ---
# Leave SMTP_HOST empty to write invites under api/.data/outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DataBuddy <noreply@localhost>
SMTP_USE_TLS=true

# --- Claude API (agent layer; LangGraph calls this) ---
# Create at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# default model id for the agent (must stay on the cheap Sonnet tier for budget)
ANTHROPIC_MODEL=claude-sonnet-5-20260514
# hard cap per student for the pilot period, in USD
USER_TOKEN_BUDGET_USD=50
# institution budget enforcement (false for single-campus pilot)
ENFORCE_INSTITUTION_BUDGET=false
INSTITUTION_TOKEN_BUDGET_USD=250

# --- E2B sandbox ---
# Create at https://e2b.dev/
E2B_API_KEY=
# template id after you run: e2b template build (see sandbox/README.md)
E2B_TEMPLATE_ID=databuddy-sandbox
# per-run wall-clock seconds (threat-model: 120)
E2B_TIMEOUT_SECONDS=120
# always false in production; defaults to on in the E2B SDK if omitted
E2B_ALLOW_INTERNET_ACCESS=false

# --- Web (Next.js) ---
# browser calls same-origin /api; this is only for server-side Next fetches if needed
NEXT_PUBLIC_APP_URL=http://localhost:3000
# internal URL the Next.js container uses to reach FastAPI
API_INTERNAL_URL=http://api:8000
